# Copy to .env and fill in. Never commit .env.

# --- LLM (any OpenAI-compatible API) ---
# Presets: groq | openai | gemini | ollama | custom
MNEMO_LLM_PROVIDER=groq
GROQ_API_KEY=
# MNEMO_LLM_MODEL=openai/gpt-oss-120b   # also: openai/gpt-oss-20b, qwen/qwen3.8-27b
# MNEMO_LLM_REASONING_EFFORT=low
# MNEMO_LLM_BASE_URL=          # only needed for provider=custom
# MNEMO_LLM_API_KEY=           # overrides the provider-specific key above

# --- Embeddings ---
# fastembed runs locally on CPU (free, no API key). "openai" uses the LLM provider's embedding API.
MNEMO_EMBEDDER=fastembed
# MNEMO_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Storage ---
MNEMO_STORE=sqlite
MNEMO_SQLITE_PATH=mnemo.db
# MNEMO_STORE=postgres
# MNEMO_POSTGRES_URL=postgresql://mnemo:mnemo@localhost:5432/mnemo

# --- Retrieval tuning ---
# MNEMO_RECENCY_HALF_LIFE_DAYS=30
# MNEMO_RECENCY_WEIGHT=0.1
# MNEMO_IMPORTANCE_WEIGHT=0.1
# MNEMO_RERANK=false

# --- API server ---
# Comma-separated list. When empty, the API is open (fine for local dev only).
# MNEMO_API_KEYS=dev-key-1,dev-key-2
# MNEMO_RATE_LIMIT_PER_MINUTE=120

# --- Optional tracing (Langfuse) ---
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
